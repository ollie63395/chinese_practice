# Copy to .env.local and fill in. For local development, `npx supabase start` prints these values.
# In production, set the two VITE_ values in Vercel (Project → Settings → Environment Variables);
# they come from your Supabase project (Project Settings → API Keys / Data API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for the database and browser tests against local Supabase. Never set this in Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
